# Copy to .env and fill in your real values (do not commit .env)

# Used directly by `pnpm dev` / `pnpm db:migrate` on the host (points at
# localhost). Also read by docker-compose.yml to set up the `db` service —
# the `app`/`migrate` services override DATABASE_URL's host to `db` themselves,
# so you don't need to edit that part by hand.
POSTGRES_USER="stockuser"
POSTGRES_PASSWORD="stockpass"
POSTGRES_DB="stockdb"

# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://stockuser:stockpass@localhost:5432/stockdb?schema=public"

# Better Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_STRING_32_CHARS_OR_MORE"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
